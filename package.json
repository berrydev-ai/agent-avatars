{
  "name": "agent-avatars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "generate:avatars": "tsx scripts/avatars/generate.ts",
    "validate:manifest": "tsx scripts/avatars/validate-manifest.ts",
    "check:database-types": "node scripts/supabase/check-generated-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db:sql": "supabase db reset --local && supabase db lint --local --level warning --fail-on warning && supabase test db --local",
    "test:db:integration": "node scripts/supabase/run-integration-tests.mjs",
    "test:members-cap": "tsx scripts/supabase/membership-cap-probe.ts",
    "test:db": "npm run test:db:sql && npm run test:db:integration && npm run test:members-cap",
    "test:e2e": "playwright test",
    "build:app": "npm run validate:manifest && vite build",
    "build:identity": "tsc -p tsconfig.build.json",
    "build": "npm run build:app && npm run build:identity",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:db && npm run check:database-types && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
